
# ==================================================
# RESTOFY - COMPLETE DEV PROFILE TEMPLATE
# ==================================================

# APPLICATION
APP_NAME=restofy
APP_ENV=dev
COMPOSE_PROJECT_NAME=restofy-dev
SPRING_PROFILES_ACTIVE=dev

# ==================================================
# FRONTEND
# ==================================================

FRONTEND_HOST_PORT=5000
FRONTEND_INTERNAL_PORT=3000

# ==================================================
# API GATEWAY
# ==================================================

API_GATEWAY_HOST_PORT=5050

# ==================================================
# MICROSERVICE HOST PORTS
# ==================================================

AUTH_SERVICE_HOST_PORT=5051
ORDER_SERVICE_HOST_PORT=5052
KITCHEN_SERVICE_HOST_PORT=5053
WAITER_SERVICE_HOST_PORT=5054
MENU_SERVICE_HOST_PORT=5055
QR_SERVICE_HOST_PORT=5056
PAYMENT_SERVICE_HOST_PORT=5057
NOTIFICATION_SERVICE_HOST_PORT=5058
ADMIN_SERVICE_HOST_PORT=5059
RATING_SERVICE_HOST_PORT=5060
MAIL_SERVICE_HOST_PORT=5061
TIMER_SERVICE_HOST_PORT=5062

# COMMON CONTAINER PORT
BACKEND_INTERNAL_PORT=8080

# ==================================================
# POSTGRESQL
# ==================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5489

POSTGRES_USER=restofy
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# DATABASE CONNECTION POOL
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# SERVICE DATABASE NAMES
DB_AUTH_NAME=restofy_auth
DB_ORDER_NAME=restofy_order
DB_KITCHEN_NAME=restofy_kitchen
DB_WAITER_NAME=restofy_waiter
DB_MENU_NAME=restofy_menu
DB_QR_NAME=restofy_qr
DB_PAYMENT_NAME=restofy_payment
DB_NOTIFICATION_NAME=restofy_notification
DB_ADMIN_NAME=restofy_admin
DB_RATING_NAME=restofy_rating
DB_MAIL_NAME=restofy_mail
DB_TIMER_NAME=restofy_timer

# ==================================================
# INTERNAL MICROSERVICE URLS
# ==================================================

API_GATEWAY_INTERNAL_URL=http://api-gateway:8080

AUTH_SERVICE_URL=http://auth-service:8080
ORDER_SERVICE_URL=http://order-service:8080
KITCHEN_SERVICE_URL=http://kitchen-service:8080
WAITER_SERVICE_URL=http://waiter-service:8080
MENU_SERVICE_URL=http://menu-service:8080
QR_SERVICE_URL=http://qr-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080
ADMIN_SERVICE_URL=http://admin-service:8080
RATING_SERVICE_URL=http://rating-service:8080
MAIL_SERVICE_URL=http://mail-service:8080
TIMER_SERVICE_URL=http://timer-service:8080

# ==================================================
# RESTCLIENT
# ==================================================

REST_CLIENT_CONNECT_TIMEOUT_MS=3000
REST_CLIENT_READ_TIMEOUT_MS=5000

# ==================================================
# SECURITY
# ==================================================

JWT_ISSUER=restofy-auth
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# QR payload encryption: initialize once with node ops/qr/qr-key.mjs init dev.
# Keep this example empty; see docs/qr/qr-key-uretimi.md. QR rejects an empty/invalid runtime key.
QR_PAYLOAD_ENCRYPTION_KEY=
# AUTH-02 session settings (required, no defaults). Real values only in ignored ENV files.
# AUTH_RESTAURANT_ID: single fixed restaurant UUID, identical across the team.
# AUTH_JWT_PRIVATE_KEY: Base64 PKCS#8 RSA key (min 2048 bit). AUTH_CSRF_SECRET: Base64, min 32 random bytes.
# AUTH_COOKIE_SECURE: false only for local HTTP development; must be true in production.
AUTH_RESTAURANT_ID=
AUTH_JWT_PRIVATE_KEY=
AUTH_CSRF_SECRET=
AUTH_COOKIE_SECURE=

# AUTH_MFA_REQUIRED: ADMIN MFA switch (default true). false is accepted ONLY with dev/local/test profile and APP_ENV; any other value fails startup.
AUTH_MFA_REQUIRED=true

# AUTH-03/AUTH-04 secrets (required, no defaults). Real values only in ignored ENV files; never reuse across environments.
# AUTH_MFA_ENCRYPTION_KEY: Base64, exactly 32 random bytes (AES-256-GCM key for TOTP secrets).
# AUTH_RESET_HMAC_KEY: Base64, min 32 random bytes (HMAC key for password-reset codes and cookies).
AUTH_MFA_ENCRYPTION_KEY=
AUTH_RESET_HMAC_KEY=

# Mail Service (AUTH-04). Real values only in ignored ENV files.
# MAIL_AUTH_PUBLIC_KEY: Base64 X.509 public key matching AUTH_JWT_PRIVATE_KEY (verifies Auth service tokens).
# MAIL_SMTP_TLS_MODE: STARTTLS | SMTPS | NONE (NONE only with dev/local/test profile and host localhost/127.0.0.1).
MAIL_AUTH_PUBLIC_KEY=
MAIL_FROM_ADDRESS=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_TLS_MODE=
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# AUTH-01 bootstrap: disabled by default. Set credentials only in ignored ENV files.
# Development users require dev/local/test profiles and APP_ENV; never enable in production.
AUTH_DEV_USERS_ENABLED=false
AUTH_DEV_ADMIN_EMAIL=
AUTH_DEV_ADMIN_PASSWORD=
AUTH_DEV_WAITER_EMAIL=
AUTH_DEV_WAITER_PASSWORD=
AUTH_DEV_KITCHEN_EMAIL=
AUTH_DEV_KITCHEN_PASSWORD=
# Independent first ADMIN setup. Do not enable alongside development users.
# After setup: disable, remove bootstrap credentials and recreate the Auth container.
AUTH_INITIAL_ADMIN_ENABLED=false
AUTH_INITIAL_ADMIN_EMAIL=
AUTH_INITIAL_ADMIN_PASSWORD=

# ==================================================
# SWAGGER / OPENAPI
# ==================================================

SWAGGER_ENABLED=true

# ==================================================
# LOGGING
# ==================================================

LOG_LEVEL=INFO
TZ=UTC

# ==================================================
# SONARQUBE
# ==================================================

SONARQUBE_HOST_PORT=5099
SONARQUBE_INTERNAL_PORT=9000

SONAR_HOST_URL=http://localhost:5099
SONAR_TOKEN=

SONAR_BACKEND_PROJECT_KEY=restofy-backend
SONAR_FRONTEND_PROJECT_KEY=restofy-frontend

# Separate local SonarQube database. Fill the password only in ignored profile files.
SONAR_DB_NAME=restofy_sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=

# PUBLIC APPLICATION SETTINGS
# Exact customer QR page URL; HTTPS required except loopback in dev/test. No query/fragment.
QR_PUBLIC_ENTRY_URL=
FRONTEND_PUBLIC_URL=http://localhost:5000
API_GATEWAY_PUBLIC_URL=http://localhost:5050
NEXT_PUBLIC_API_BASE_URL=http://localhost:5050
CORS_ALLOWED_ORIGINS=http://localhost:5000
